# ============================================================================
# Copy to .env.local and fill in. This template IS committed; .env.local is not.
#
# Relay degrades gracefully: anything left blank turns that integration off.
# A missing credential produces a named error, never a silent fallback.
# ============================================================================


# ── The clock. ──────────────────────────────────────────────────────────────
# UNSET = the real system clock (what production runs on).
# Set to freeze Relay at an instant for the seeded demo, whose data describes
# the week of Mon 6 – Sun 12 Jul 2026. Today shows a banner when it's pinned.
# Clear before any production deploy.
# RELAY_PILOT_NOW=2026-07-13T08:15:00+04:00


# ── Supabase — the app's database. REQUIRED. ────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── Google Sheets — the agency tracker (Phase 7). Read-only. ────────────────
# Blank → Relay reads supabase/fixtures/tracker.json instead.
# The sheet must be SHARED with the service-account email as Viewer.
#
# Preferred: point at the key JSON Google downloaded. Keeping key material in
# a git-ignored file (relay/secrets/) keeps it out of shell history, editor
# diffs and screenshots, and makes rotation a one-file swap.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=secrets/relay-tracker-reader.json

# Env-var fallback for deploy targets that only offer env vars (Vercel).
# The key file wins when both are set. Must include the BEGIN header, keep
# literal \n escapes, and be wrapped in double quotes.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Alternative if your org enforces iam.disableServiceAccountKeyCreation.
# Not yet wired.
# GOOGLE_SHEETS_CLIENT_ID=
# GOOGLE_SHEETS_CLIENT_SECRET=
# GOOGLE_SHEETS_REFRESH_TOKEN=


# ── The daily compile cron (Phase 7.5a). ────────────────────────────────────
# /api/cron/daily returns 503 without this, 401 without a matching
# `Authorization: Bearer <secret>` header. Fail-closed by design.
# Generate:  openssl rand -base64 32
# Must match the value set in Vercel's env vars.
CRON_SECRET=


# ── Google Ads — direct pull (Phase 7.5b). Not yet wired. ───────────────────
# MCC-level OAuth: one grant covers every linked client account.
# LOGIN_CUSTOMER_ID is the MCC, digits only, no dashes.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=


# ── Triple Whale — new-customer metrics (Layer C). Not yet wired. ───────────
# The only source for NC ROAS / NCAC / NVP.
TRIPLE_WHALE_API_KEY=


# ── Anthropic — narrative + answer generation (Phase 8). Not yet wired. ─────
# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=
